#!/usr/bin/env bash
# Checks that the starter still works after removing modules:
# copies the project into a temp directory, removes the modules there with
# `php artisan module:remove` and runs tests and build.
#
#   bin/check-module-removal registration
#   bin/check-module-removal registration map gallery
set -euo pipefail

if [ $# -eq 0 ]; then
  echo "Usage: bin/check-module-removal <module> [<module> ...]" >&2
  exit 1
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TMP="$(mktemp -d /tmp/immosite-check.XXXXXX)"
trap 'rm -rf "$TMP"' EXIT

rsync -a --exclude node_modules --exclude vendor --exclude refs --exclude .git --exclude public/build "$ROOT/" "$TMP/"
ln -s "$ROOT/vendor" "$TMP/vendor"
ln -s "$ROOT/node_modules" "$TMP/node_modules"

cd "$TMP"
php artisan module:remove "$@"
# Livewire/Blade caches may point to deleted classes.
php artisan optimize:clear > /dev/null
php artisan test
npm run build > /dev/null
echo "OK: tests and build pass without [$*]."
