APP_NAME="Immosite"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de_CH
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_CH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Analytics – set on live only
GOOGLE_ANALYTICS_ID=

# Block indexing (staging: true, live: leave empty)
ROBOTS_NOINDEX=

# Cloudflare Turnstile (spam protection) – empty = honeypot only
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Weekly list of registrations (multiple addresses comma-separated)
REGISTRATIONS_EXPORT_EMAIL=
REGISTRATIONS_EXPORT_BCC=
# 1 = Monday; time in Europe/Zurich
REGISTRATIONS_EXPORT_DAY=1
REGISTRATIONS_EXPORT_TIME=08:00

# Contact form: recipients (multiple comma-separated), empty = marketing contact from config/site.php
CONTACT_RECIPIENTS=

# Mapbox (pk.…, restrict to the domain in the Mapbox account)
MAPBOX_TOKEN=
MAPBOX_STYLE=

# Apartments: static | flatfox | melon
APARTMENTS_DRIVER=static
FLATFOX_API_URL=
MELON_API_URL=
MELON_MOCK=false

# Melon lead hook (contact/application form → Melon)
MELON_HOOK_ENABLED=false
MELON_HOOK_URL=
MELON_HOOK_USERNAME=
MELON_HOOK_PASSWORD=

# Commercial units: static | apartments | database (commercial-admin)
COMMERCIAL_SOURCE=static
